#cloud-config
# Unattended provisioning for Husk's Phase 1 guest -- the SHIPPING (thin) image.
#
# Runs once on the Mac under HVF to turn a stock Debian arm64 cloud image into a
# Waydroid host. Deliberately stops short of installing Android: `waydroid init`
# runs on the phone at first-run setup instead.
#
# That split is what keeps the artifact shippable. Baking LineageOS in produced a
# 6.05 GiB image; leaving it out keeps this around 1.2 GiB. It is also the only
# version that is correct -- a bake-time `waydroid init` fetches the
# waydroid_arm64_only images (728 MB system, 77 MB vendor), which is a different
# variant from the arm64 one, and hardcoding either is worse than letting
# Waydroid's own resolver choose. And we never redistribute LineageOS: it comes
# from Waydroid's servers, through Waydroid's own setup path.

hostname: husk-guest
disable_root: false
ssh_pwauth: true

users:
  - name: husk
    plain_text_passwd: husk
    lock_passwd: false
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash
    groups: [sudo, video, render, input]

write_files:
  - path: /usr/local/bin/husk-provision.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      set -x
      exec > >(tee -a /var/log/husk-provision.log) 2>&1
      echo "HUSK-PROVISION: begin"

      export DEBIAN_FRONTEND=noninteractive
      apt-get update
      apt-get install -y --no-install-recommends \
          ca-certificates curl wget gnupg lxc python3 python3-gbinder \
          cage seatd libgbm1 mesa-utils dbus-user-session dbus-x11 unzip \
          pipewire pipewire-pulse wireplumber

      curl -fsSL https://repo.waydro.id | bash
      apt-get update
      apt-get install -y waydroid

      # Waydroid needs binder. Mainline has had it for years, but Debian builds it
      # as a module rather than baking it in, so it must be requested explicitly
      # and made permanent. Confirmed working: /dev/binder, /dev/hwbinder and
      # /dev/vndbinder all appear.
      modprobe binder_linux devices="binder,hwbinder,vndbinder" || true
      echo "binder_linux" > /etc/modules-load.d/waydroid.conf
      echo "options binder_linux devices=binder,hwbinder,vndbinder" \
          > /etc/modprobe.d/waydroid.conf
      ls -la /dev/binder /dev/hwbinder /dev/vndbinder 2>&1 || true

      # liblxc's own diagnosis of a failed start is thrown away by default.
      # Waydroid runs "lxc-start -F" with output=background, which forwards the
      # child's stderr to its log, but the useful detail -- which mount failed,
      # which capability was refused -- goes to liblxc's log file, and Waydroid
      # never sets one. The container config is rebuilt by concatenating these
      # templates at every session start, so the template is the only place the
      # setting survives.
      printf '\nlxc.log.file = /var/log/waydroid-lxc.log\nlxc.log.level = DEBUG\n' \
          >> /usr/lib/waydroid/data/configs/config_base
      tail -n 5 /usr/lib/waydroid/data/configs/config_base

      # Waydroid chooses its graphics stack by looking for a DRM render node:
      #
      #     if dri:  gralloc = "gbm";     egl = "mesa"
      #     else:    gralloc = "default"; egl = "swiftshader"
      #
      # virtio-gpu publishes /dev/dri/renderD128 whether or not it can render.
      # Ours cannot -- the kernel reports "[drm] features: -virgl", so there is
      # no 3D at all -- and pointing gralloc.gbm at it makes hwcomposer take
      # SIGSEGV and SurfaceFlinger abort behind it. The "no GPU" configuration
      # is the correct one here; Waydroid simply never picks it while the node
      # exists. Its probe skips drivers named in this list, so naming virtio_gpu
      # selects the software path through Waydroid's own logic rather than by
      # overriding the properties it derives afterwards.
      sed -i 's/^unsupported = \["nvidia"\]/unsupported = ["nvidia", "virtio_gpu", "virtio-gpu"]/' \
          /usr/lib/waydroid/tools/helpers/gpu.py
      grep -n '^unsupported' /usr/lib/waydroid/tools/helpers/gpu.py
      # Editing a .py under a package that may ship precompiled bytecode does
      # nothing if the old .pyc is still considered valid, which is one way the
      # edit above could have been silently ignored.
      find /usr/lib/waydroid -name __pycache__ -type d -exec rm -rf {} + 2>/dev/null || true

      echo "guest-v13" > /etc/husk-image-version

      mkdir -p /mnt/husk
      systemctl enable seatd || true
      systemctl enable mnt-husk.mount husk-agent.service husk-ui.service
      systemctl enable husk-firstboot.service
      systemctl enable waydroid-container || true

      # Install GRUB at the removable-media fallback path (\EFI\BOOT\BOOTAA64.EFI)
      # as well as its own. Debian's cloud image relies on an NVRAM boot entry, and
      # those record PCI device paths -- so adding a virtio device renumbers the bus
      # and the entry stops resolving, at which point the firmware tries PXE and
      # lands in the EFI Shell. The fallback path is found by scanning, so it
      # survives any device reordering.
      grub-install --removable --target=arm64-efi --efi-directory=/boot/efi 2>&1 || \
          echo "HUSK-PROVISION: grub-install --removable failed (non-fatal)"

      echo "HUSK-PROVISION: done"
      touch /var/lib/husk-provisioned

  # Runs on the phone, not here. Everything it prints goes to the serial console,
  # which Husk already tails into its own log -- so setup progress shows up in the
  # app without any extra channel.
  - path: /usr/local/bin/husk-firstboot.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      # Status goes to the framebuffer console as well as the serial line: the
      # serial line feeds Husk's log, the console is the screen being looked at.
      exec > >(tee -a /var/log/husk-firstboot.log > /dev/console) 2>&1

      # Waydroid looks for ready-made images in preinstalled_images_paths before
      # it downloads anything. From tools/actions/initializer.py:
      #
      #     if has_preinstalled_images:
      #         cfg["waydroid"]["system_ota"] = "None"
      #         return True        <- returns before any download
      #
      # So dropping system.img and vendor.img in /etc/waydroid-extra/images makes
      # init skip its fetch entirely. Putting them in /var/lib/waydroid/images --
      # the RUNTIME path -- does not; that was why a previous version downloaded
      # everything twice.
      PRE=/etc/waydroid-extra/images
      if [ -f /var/lib/husk-setup-complete ]; then
          echo "HUSK-SETUP: already initialised"
          exit 0
      fi
      mkdir -p "$PRE" /var/cache/husk
      cd /var/cache/husk

      # Mirrored on our own release rather than fetched from SourceForge, which
      # serves these at ~0.28 MB/s against GitHub's ~26 MB/s -- the difference
      # between about an hour and under a minute for the same bytes.
      BASE="https://github.com/Leviidev/Husk/releases/download/android-v1"

      fetch() {
          local url="$1" out="$2" label="$3"
          [ -f "$out" ] && { echo "HUSK-SETUP: $label already fetched"; return 0; }
          echo "HUSK-SETUP: downloading $label"
          wget -q -c -O "$out.part" "$url" &
          local pid=$!
          while kill -0 $pid 2>/dev/null; do
              local mb=$(du -m "$out.part" 2>/dev/null | cut -f1)
              echo "HUSK-SETUP: $label ${mb:-0} MB"
              sleep 5
          done
          wait $pid || return 1
          mv "$out.part" "$out"
      }

      if fetch "$BASE/system.zip" system.zip "Android system" && \
         fetch "$BASE/vendor.zip" vendor.zip "Android vendor"; then
          echo "HUSK-SETUP: extracting"
          ( unzip -o -q system.zip -d "$PRE" && unzip -o -q vendor.zip -d "$PRE" ) &
          upid=$!
          while kill -0 $upid 2>/dev/null; do
              mb=$(du -sm "$PRE" 2>/dev/null | cut -f1)
              echo "HUSK-SETUP: extracting (${mb:-0} MB)"
              sleep 10
          done
          wait $upid || { echo "HUSK-SETUP: extraction FAILED"; exit 1; }
          rm -f system.zip vendor.zip
          ls -la "$PRE"
      else
          echo "HUSK-SETUP: mirror download FAILED; falling back to waydroid's own"
      fi

      echo "HUSK-SETUP: initialising waydroid"
      waydroid init || echo "HUSK-SETUP: waydroid init returned $?"
      echo "HUSK-SETUP: waydroid status: $(waydroid status 2>&1 | tr '\n' ' ')"

      # The completion marker. Everything downstream waits on THIS, not on the
      # presence of a file that unzip creates the instant it starts writing.
      touch /var/lib/husk-setup-complete
      echo "HUSK-SETUP: complete"

  - path: /usr/local/bin/husk-agent.py
    permissions: '0755'
    content: |
      #!/usr/bin/env python3
      import json, os, shutil, subprocess, sys, time, glob, traceback

      SHARE   = "/mnt/husk"
      INBOX   = f"{SHARE}/inbox"
      CMDS    = f"{SHARE}/commands"
      RESULTS = f"{SHARE}/results"
      CATALOG = f"{SHARE}/catalog"
      ICONS   = f"{CATALOG}/icons"
      STATE   = "/var/lib/husk-agent"

      def log(msg):
          # Goes to the serial console, which Husk already folds into its own log.
          print(f"HUSK-AGENT: {msg}", flush=True)
          try:
              with open("/dev/ttyAMA0", "w") as f:
                  f.write(f"HUSK-AGENT: {msg}\n")
          except Exception:
              pass

      def run(cmd, timeout=300):
          log(f"run {cmd}")
          p = subprocess.run(cmd, shell=True, capture_output=True, text=True, timeout=timeout)
          if p.returncode != 0:
              log(f"  rc={p.returncode} err={p.stderr.strip()[:300]}")
          return p

      def publish_diagnostics():
          """Dump the state of everything Husk depends on into the share.

          The user should never have to run systemctl or journalctl by hand to
          tell us what happened, so the guest reports on itself and Husk logs it.
          """
          parts = []
          for cmd in ("systemctl is-active husk-ui husk-agent waydroid-container seatd",
                      "waydroid status",
                      "cat /etc/husk-image-version",
                      "grep -hE 'gralloc|egl|vulkan' /var/lib/waydroid/waydroid_base.prop",
                      "ls -la /dev/binder /dev/hwbinder /dev/vndbinder",
                      "ls -la /dev/dri",
                      "free -m",
                      "tail -n 60 /var/lib/waydroid/waydroid.log",
                      "grep -aE 'ERROR|WARN' /var/log/waydroid-lxc.log | tail -n 30",
                      "lxc-info -P /var/lib/waydroid/lxc -n waydroid",
                      "dmesg | tail -n 15",
                      "timeout 20 waydroid logcat -d 2>&1 | tail -n 200",
                      "ls -la /root/.local/share/waydroid/data/tombstones/",
                      "tail -n 80 /dev/null $(ls -t /root/.local/share/waydroid/data/tombstones/* 2>/dev/null | head -1)",
                      "tail -n 40 /var/log/husk-ui.log",
                      "tail -n 40 /var/log/husk-firstboot.log",
                      "journalctl -u husk-ui --no-pager -n 30"):
              p = subprocess.run(cmd, shell=True, capture_output=True, text=True)
              parts.append(f"$ {cmd}\n{p.stdout}{p.stderr}\n")
          try:
              tmp = f"{SHARE}/diagnostics.txt.tmp"
              with open(tmp, "w") as f:
                  f.write("\n".join(parts))
              os.replace(tmp, f"{SHARE}/diagnostics.txt")
              log("diagnostics published")
          except Exception as e:
              log(f"could not publish diagnostics: {e}")

      def ensure_dirs():
          for d in (INBOX, CMDS, RESULTS, CATALOG, ICONS, STATE):
              os.makedirs(d, exist_ok=True)

      def session_up():
          p = run("waydroid status", timeout=30)
          return "RUNNING" in p.stdout

      def parse_app_list(text):
          apps, cur = [], {}
          for line in text.splitlines():
              line = line.strip()
              if not line:
                  if cur.get("packageName"):
                      apps.append(cur)
                  cur = {}
                  continue
              if ":" in line:
                  k, v = line.split(":", 1)
                  cur[k.strip()] = v.strip()
          if cur.get("packageName"):
              apps.append(cur)
          return apps

      def find_icon(pkg):
          # Waydroid exports launchers as .desktop files with icons alongside.
          # Where exactly varies by version, so search rather than assume, and say
          # what was found -- guessing here would fail silently as a blank grid.
          pats = [
              f"/root/.local/share/icons/**/waydroid.{pkg}.*",
              f"/home/*/.local/share/icons/**/waydroid.{pkg}.*",
              f"/usr/share/icons/**/waydroid.{pkg}.*",
              f"/var/lib/waydroid/data/**/waydroid.{pkg}.*",
          ]
          for pat in pats:
              hits = glob.glob(pat, recursive=True)
              if hits:
                  return sorted(hits, key=os.path.getsize)[-1]
          return None

      def refresh_catalog():
          p = run("waydroid app list", timeout=120)
          apps = parse_app_list(p.stdout)
          out = []
          for a in apps:
              pkg  = a.get("packageName")
              name = a.get("Name") or pkg
              if not pkg:
                  continue
              entry = {"package": pkg, "name": name}
              icon = find_icon(pkg)
              if icon:
                  dest = f"{ICONS}/{pkg}.png"
                  try:
                      shutil.copyfile(icon, dest)
                      entry["icon"] = f"icons/{pkg}.png"
                  except Exception as e:
                      log(f"icon copy failed for {pkg}: {e}")
              out.append(entry)
          tmp = f"{CATALOG}/apps.json.tmp"
          with open(tmp, "w") as f:
              json.dump({"apps": out, "updated": time.time()}, f)
          os.replace(tmp, f"{CATALOG}/apps.json")
          log(f"catalog refreshed: {len(out)} apps, "
              f"{sum(1 for a in out if 'icon' in a)} with icons")

      def write_result(cid, ok, detail=""):
          tmp = f"{RESULTS}/{cid}.json.tmp"
          with open(tmp, "w") as f:
              json.dump({"id": cid, "ok": ok, "detail": detail, "at": time.time()}, f)
          os.replace(tmp, f"{RESULTS}/{cid}.json")

      def handle_command(path):
          cid = os.path.splitext(os.path.basename(path))[0]
          try:
              with open(path) as f:
                  cmd = json.load(f)
          except Exception as e:
              write_result(cid, False, f"unreadable command: {e}")
              os.remove(path); return
          os.remove(path)

          action = cmd.get("action")
          log(f"command {cid}: {action} {cmd}")
          try:
              if action == "launch":
                  pkg = cmd["package"]
                  p = run(f"waydroid app launch {pkg}")
                  write_result(cid, p.returncode == 0, p.stderr.strip()[:500])
              elif action == "stop":
                  p = run("waydroid session stop")
                  write_result(cid, p.returncode == 0, p.stderr.strip()[:500])
              elif action == "refresh":
                  refresh_catalog()
                  write_result(cid, True)
              elif action == "diagnostics":
                  publish_diagnostics()
                  write_result(cid, True)
              else:
                  write_result(cid, False, f"unknown action {action}")
          except Exception:
              write_result(cid, False, traceback.format_exc()[-500:])

      def handle_apk(path):
          name = os.path.basename(path)
          log(f"installing {name}")
          p = run(f"waydroid app install '{path}'", timeout=900)
          ok = p.returncode == 0
          write_result(f"install-{name}", ok, (p.stderr or p.stdout).strip()[:500])
          # Move it out of the inbox either way, so a failing APK is not retried
          # forever on every poll.
          done = f"{SHARE}/installed" if ok else f"{SHARE}/failed"
          os.makedirs(done, exist_ok=True)
          try:
              shutil.move(path, f"{done}/{name}")
          except Exception as e:
              log(f"could not move {name}: {e}")
          if ok:
              refresh_catalog()

      boot_reports = 0
      last_boot_report = 0.0

      def tune_for_speed():
          """Turn off UI animations once Android is up.

          Window, transition and animator scales are Settings.Global values
          living in /data, so unlike the graphics properties they cannot be set
          before boot. Every animation is composited by a software rasteriser
          running on an emulated CPU, which makes them disproportionately
          expensive here -- and they are pure latency between a tap and the
          thing the user asked for. Setting all three to 0 is what the
          developer options "animations off" switch does.
          """
          for k in ("window_animation_scale",
                    "transition_animation_scale",
                    "animator_duration_scale"):
              p = subprocess.run(f"timeout 20 waydroid shell settings put global {k} 0",
                                 shell=True, capture_output=True, text=True)
              log(f"tune: {k}=0 rc={p.returncode} {p.stderr.strip()[:80]}")

      def android_ready():
          try:
              p = subprocess.run("timeout 15 waydroid shell getprop sys.boot_completed",
                                 shell=True, capture_output=True, text=True)
              return p.stdout.strip() == "1"
          except Exception:
              return False

      def main():
          log("starting")
          while not os.path.ismount(SHARE):
              log(f"waiting for {SHARE} to be mounted")
              time.sleep(2)
          ensure_dirs()
          publish_diagnostics()
          log("share is mounted; waiting for the Waydroid session")

          warned = False
          last_catalog = 0
          while True:
              try:
                  if not session_up():
                      if not warned:
                          log("waydroid session is not RUNNING yet")
                          publish_diagnostics()
                          warned = True
                      time.sleep(3)
                      continue
                  if warned:
                      log("waydroid session is up")
                      warned = False

                  # The session being up no longer means Android is. It now
                  # starts and then crash-loops inside the container, where
                  # husk-ui.sh's dump cannot see it because cage never exits.
                  # Keep publishing until sys.boot_completed, then stop -- a
                  # bounded number of times, so a permanent failure does not
                  # scroll the log forever.
                  global boot_reports, last_boot_report
                  if boot_reports < 8 and time.time() - last_boot_report > 45:
                      if not android_ready():
                          log(f"android has not finished booting (report {boot_reports + 1}/8)")
                          publish_diagnostics()
                          boot_reports += 1
                      else:
                          log("android reports boot_completed")
                          tune_for_speed()
                          boot_reports = 8
                      last_boot_report = time.time()

                  for c in sorted(glob.glob(f"{CMDS}/*.json")):
                      handle_command(c)
                  for a in sorted(glob.glob(f"{INBOX}/*.apk")):
                      handle_apk(a)
                  if time.time() - last_catalog > 30:
                      refresh_catalog()
                      last_catalog = time.time()
              except Exception:
                  log("loop error: " + traceback.format_exc()[-400:])
              time.sleep(0.5)

      if __name__ == "__main__":
          main()

  - path: /etc/systemd/system/mnt-husk.mount
    content: |
      [Unit]
      Description=Husk host share (virtio-9p)
      [Mount]
      What=husk
      Where=/mnt/husk
      Type=9p
      Options=trans=virtio,version=9p2000.L,msize=512000,rw
      [Install]
      WantedBy=multi-user.target

  - path: /etc/systemd/system/husk-agent.service
    content: |
      [Unit]
      Description=Husk guest agent
      After=mnt-husk.mount waydroid-container.service
      Wants=mnt-husk.mount
      [Service]
      ExecStart=/usr/local/bin/husk-agent.py
      Restart=always
      RestartSec=3
      [Install]
      WantedBy=multi-user.target


  # Brings Android up on the framebuffer with no login and no commands.
  #
  # Waydroid renders as a Wayland client, so something has to be running a
  # compositor for it to appear in. cage is the right one here: it shows a single
  # client fullscreen with no decorations, which is exactly the illusion Husk
  # wants, rather than a desktop with a window in it.
  - path: /usr/local/bin/husk-ui.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      # Write to the framebuffer console as well as the serial line. The serial
      # line feeds Husk's log, but the console is the screen the user is actually
      # looking at -- and a silent wait there is indistinguishable from a hang.
      # /dev/console is ttyAMA0 on this machine (ACPI SPCR selects it), so writing
      # to both duplicated every line. One is enough and still reaches the serial log.
      exec > >(tee -a /var/log/husk-ui.log > /dev/console) 2>&1
      echo "HUSK-UI: starting"
      # Which image is this? Inferring it from the shape of the diagnostics is
      # how a stale build went unnoticed for a whole round trip.
      echo "HUSK-UI: image $(cat /etc/husk-image-version 2>/dev/null || echo unknown)"

      # There is no GPU behind virtio-gpu here, so wlroots must render in
      # software. Without this cage fails to start a renderer and exits, which
      # looks identical to Waydroid not working.
      export WLR_RENDERER=pixman
      export WLR_BACKENDS=drm
      export XDG_RUNTIME_DIR=/run/husk-ui
      export XDG_SESSION_TYPE=wayland
      export HOME=/root
      mkdir -p "$XDG_RUNTIME_DIR"
      chmod 700 "$XDG_RUNTIME_DIR"

      # waydroid init runs on first boot and downloads ~800 MB; there is nothing
      # to show until it has finished.
      waited=0
      # Wait for the marker first-boot writes when it is genuinely finished.
      #
      # Neither of the obvious files works as a gate: waydroid.cfg is written by
      # init BEFORE it downloads anything, and images/system.img is created by
      # unzip the instant extraction starts. Gating on either launches cage while
      # Waydroid is still uninitialised, which exits immediately and leaves
      # systemd restarting it every 5 seconds forever.
      while [ ! -f /var/lib/husk-setup-complete ]; do
          sz=$(du -sm /var/cache/husk /etc/waydroid-extra/images 2>/dev/null | awk '{t+=$1} END{print t}')
          echo "HUSK-UI: Android setup in progress (${sz:-0} MB, ${waited}s elapsed)"
          sleep 10
          waited=$((waited + 10))
      done
      echo "HUSK-UI: setup is complete"

      # Belt and braces: ask Waydroid itself, so a marker left by a partial run
      # cannot start the loop again.
      until ! waydroid status 2>&1 | grep -q "not initialized"; do
          echo "HUSK-UI: waydroid still reports uninitialised; waiting"
          sleep 10
      done

      for d in /dev/dri/card*; do
          echo "HUSK-UI: drm node $d"
      done

      echo "HUSK-UI: seatd: $(systemctl is-active seatd 2>&1)"

      # Waydroid derives the graphics stack ONCE, during "waydroid init", from
      # whether a DRM render node exists (tools/helpers/lxc.py):
      #
      #     if dri:  gralloc = "gbm";     egl = "mesa"
      #     else:    gralloc = "default"; egl = "swiftshader"
      #
      # virtio-gpu publishes /dev/dri/renderD128 whether or not it can render,
      # and ours cannot: the kernel reports "[drm] features: -virgl". Waydroid
      # then aims gralloc.gbm at a device with no driver behind it, hwcomposer
      # takes SIGSEGV and SurfaceFlinger aborts with SIGABRT in a loop. Teaching
      # its GPU probe to skip virtio_gpu should have been enough and measurably
      # was not, so rewrite what it derived into what it would have chosen on a
      # machine with no GPU at all. This edits the one file those properties
      # come from, so it cannot miss for the reason the probe patch did, and it
      # runs on every boot rather than only after init.
      BP=/var/lib/waydroid/waydroid_base.prop
      if [ -f "$BP" ]; then
          sed -i -e 's/^ro\.hardware\.gralloc=.*/ro.hardware.gralloc=default/' \
                 -e 's/^ro\.hardware\.egl=.*/ro.hardware.egl=swiftshader/' \
                 -e '/^gralloc\.gbm\.device=/d' \
                 -e '/^ro\.hardware\.vulkan=/d' "$BP"
          grep -q '^ro.hardware.gralloc=' "$BP" || echo "ro.hardware.gralloc=default" >> "$BP"
          grep -q '^ro.hardware.egl=' "$BP" || echo "ro.hardware.egl=swiftshader" >> "$BP"

          # Everything below is about speed. There is no GPU and no hardware
          # virtualisation, so every pixel is rasterised in software by a CPU
          # that is itself emulated -- the cost of drawing is paid twice. The
          # cheapest frame is the one never drawn.
          #
          # The boot animation is the clearest example: a full-screen loop,
          # composited continuously, showing nothing but that we are waiting.
          set_prop() {
              sed -i "/^$1=/d" "$BP"
              echo "$1=$2" >> "$BP"
          }
          set_prop debug.sf.nobootanimation 1
          # Android's own low-memory profile: smaller heaps, fewer cached
          # processes, less background work. It fits a 1.5 GB guest honestly
          # and costs far less than being pushed into the low-memory killer.
          set_prop ro.config.low_ram true
          # 720x1280 at xhdpi is a normal phone. Left at the default the density
          # would not match the mode QEMU is now asked for.
          set_prop ro.sf.lcd_density 320
      else
          echo "HUSK-UI: no waydroid_base.prop yet"
      fi
      # Why the probe patch missed, for next time.
      echo "HUSK-UI: drm uevent: $(cat /sys/class/drm/renderD128/device/uevent 2>&1 | tr '\n' ' ')"
      # gralloc=default + egl=swiftshader means the software path was taken;
      # gralloc=gbm + egl=mesa means Waydroid still found the render node and
      # Android will crash in hwcomposer again.
      echo "HUSK-UI: graphics: $(grep -hE '^(ro\.hardware\.(gralloc|egl|vulkan)|gralloc\.gbm\.device)=' \
          /var/lib/waydroid/waydroid_base.prop 2>/dev/null | tr '\n' ' ')"
      echo "HUSK-UI: waydroid: $(waydroid status 2>&1 | tr '\n' ' ')"
      echo "HUSK-UI: launching cage + waydroid full UI"

      # dbus-run-session, not bare cage.
      #
      # waydroid session start needs a D-Bus SESSION bus. This runs as a systemd
      # system service, so there is no user bus and no DBUS_SESSION_BUS_ADDRESS --
      # Waydroid falls back to spawning dbus-launch, which fails with
      # "org.freedesktop.DBus.Error.Spawn.ExecFailed: /usr/bin/dbus-launch
      # terminated abnormally". dbus-run-session creates the bus up front and
      # exports the address to everything below it, which is what it exists for.
      dbus-run-session -- /usr/local/bin/husk-session.sh
      rc=$?

      # "container failed to start" is LXC's generic message and says nothing on
      # its own. Dump the real evidence, once -- Restart=always retries every 5s
      # and repeating this would bury the run it first happened in.
      FAILCOUNT=/run/husk-ui-failures
      n=$(cat "$FAILCOUNT" 2>/dev/null || echo 0)
      n=$((n + 1))
      echo "$n" > "$FAILCOUNT"
      if [ "$n" -gt 1 ]; then
          echo "HUSK-UI: failure #$n (details already reported above)"
          exit $rc
      fi

      # 200 lines, not 40. Waydroid polls lxc-info once a second for ten seconds
      # and then prints an eight-frame traceback, which is about thirty lines of
      # nothing -- enough to push the "% lxc-start" invocation and everything it
      # wrote to stderr off the end of a short tail.
      echo "HUSK-UI: --- waydroid log ---"
      tail -n 200 /var/lib/waydroid/waydroid.log 2>&1
      echo "HUSK-UI: --- lxc errors ---"
      grep -aE "ERROR|WARN" /var/log/waydroid-lxc.log 2>&1 | tail -n 60
      echo "HUSK-UI: --- lxc log tail ---"
      tail -n 80 /var/log/waydroid-lxc.log 2>&1
      echo "HUSK-UI: --- container config ---"
      cat /var/lib/waydroid/lxc/waydroid/config 2>&1
      echo "HUSK-UI: --- container mount entries ---"
      cat /var/lib/waydroid/lxc/waydroid/config_nodes 2>&1
      cat /var/lib/waydroid/lxc/waydroid/config_session 2>&1
      echo "HUSK-UI: --- lxc-checkconfig ---"
      lxc-checkconfig 2>&1
      echo "HUSK-UI: --- audio ---"
      tail -n 20 /var/log/husk-audio.log 2>&1
      ls -la "$XDG_RUNTIME_DIR/pulse" 2>&1
      echo "HUSK-UI: --- apparmor ---"
      aa-enabled 2>&1
      grep -aE "waydroid" /sys/kernel/security/apparmor/profiles 2>&1
      echo "HUSK-UI: --- rootfs ---"
      ls /var/lib/waydroid/rootfs 2>&1 | head -n 20
      mount | grep -a waydroid 2>&1
      echo "HUSK-UI: --- binder ---"
      ls -la /dev/binder /dev/hwbinder /dev/vndbinder 2>&1
      echo "HUSK-UI: --- memory ---"
      free -m 2>&1
      echo "HUSK-UI: --- dmesg tail ---"
      dmesg | tail -n 25 2>&1
      echo "HUSK-UI: --- end ---"
      echo "HUSK-UI: cage exited rc=$rc -- retrying in 5s"
      exit $rc

  - path: /usr/local/bin/husk-session.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      # Runs inside dbus-run-session, and exists for one reason: Waydroid binds
      # the PulseAudio socket into the container whether or not there is one.
      #
      # tools/helpers/lxc.py, generate_session_lxc_config():
      #
      #     pulse_host_socket = os.path.join(session["pulse_runtime_path"], "native")
      #     make_entry(pulse_host_socket, pulse_container_socket[1:])
      #
      # make_entry defaults to "rbind,create=file 0 0" -- no "optional" -- and
      # skips its own existence check whenever a destination is given, which it
      # is here. On a desktop that never matters because PipeWire is running. In
      # a headless systemd service it is fatal: LXC cannot mount a source that
      # does not exist, so lxc_setup fails and the entire container is torn down
      # about 100ms after its network comes up, which surfaces only as the
      # useless "OSError: container failed to start".
      exec >> /var/log/husk-audio.log 2>&1
      echo "HUSK-AUDIO: starting pipewire in $XDG_RUNTIME_DIR"

      mkdir -p "$XDG_RUNTIME_DIR"
      pipewire &
      pipewire-pulse &
      wireplumber &

      # Wait for the socket Waydroid is going to bind, up to ten seconds.
      for _ in $(seq 1 50); do
          [ -S "$XDG_RUNTIME_DIR/pulse/native" ] && break
          sleep 0.2
      done

      if [ -S "$XDG_RUNTIME_DIR/pulse/native" ]; then
          echo "HUSK-AUDIO: pulse socket is up"
      else
          # Never let audio decide whether Android runs. A plain file satisfies
          # the bind mount; Android finds nothing listening and carries on
          # without sound, which is worth incomparably more than no container.
          echo "HUSK-AUDIO: no pulse socket after 10s -- placing a stand-in so the container can still start"
          mkdir -p "$XDG_RUNTIME_DIR/pulse"
          : > "$XDG_RUNTIME_DIR/pulse/native"
      fi
      ls -la "$XDG_RUNTIME_DIR/pulse" 2>&1

      exec cage -- /usr/bin/waydroid show-full-ui

  - path: /etc/systemd/system/husk-ui.service
    content: |
      [Unit]
      Description=Husk Android UI (cage + waydroid)
      # NOT After=husk-firstboot.service: first boot can take many minutes,
      # and ordering behind it left husk-ui queued (systemd Job 137) so it
      # could not even report why nothing was on screen.
      After=waydroid-container.service seatd.service
      Wants=waydroid-container.service seatd.service
      [Service]
      Type=simple
      ExecStart=/usr/local/bin/husk-ui.sh
      Restart=always
      RestartSec=5
      # cage needs a seat to take DRM master. seatd provides one without logind
      # having to own a real login session.
      SupplementaryGroups=video render input
      [Install]
      WantedBy=multi-user.target

  # A shell without a password prompt. Not the normal route in -- husk-ui.service
  # is -- but when something fails there needs to be somewhere to look that does
  # not require typing credentials into a framebuffer console.
  - path: /etc/systemd/system/serial-getty@ttyAMA0.service.d/autologin.conf
    content: |
      [Service]
      ExecStart=
      ExecStart=-/sbin/agetty --autologin husk --noclear %I $TERM

  - path: /etc/systemd/system/getty@tty1.service.d/autologin.conf
    content: |
      [Service]
      ExecStart=
      ExecStart=-/sbin/agetty --autologin husk --noclear %I $TERM

  - path: /etc/systemd/system/husk-firstboot.service
    content: |
      [Unit]
      Description=Husk first-boot Android setup
      After=network-online.target
      Wants=network-online.target
      [Service]
      Type=oneshot
      ExecStart=/usr/local/bin/husk-firstboot.sh
      RemainAfterExit=yes
      [Install]
      WantedBy=multi-user.target

runcmd:
  - [ /usr/local/bin/husk-provision.sh ]
  - [ sh, -c, "echo '#### HUSK-PROVISION-COMPLETE ####' > /dev/ttyAMA0" ]

power_state:
  mode: poweroff
  timeout: 60
  condition: true
