 void *
 epoxy_gles1_dlsym(const char *name)
 {
+#ifdef __APPLE__
+    /* Always ask EGL first. See epoxy_get_core_proc_address() for why dlsym
+     * cannot be trusted here: ANGLE is linked into the app with renamed entry
+     * points, and dlsym for a core name finds an unrelated image that exports
+     * it.
+     *
+     * eglGetProcAddress does return NULL for names it does not know, though,
+     * and the generated dispatch calls whatever it is given -- so an unresolved
+     * symbol arrives as SIGSEGV with nothing in the log to say which one. Fall
+     * back to dlsym, and if that fails too, say the name out loud. A named
+     * missing entry point is a bug report; a bare segfault is a mystery. */
+    {
+        void *f = epoxy_get_proc_address(name);
+        if (!f) {
+            get_dlopen_handle(&api.gles2_handle, GLES2_LIB, false, true);
+            if (api.gles2_handle)
+                f = do_dlsym(&api.gles2_handle, name, false);
+        }
+        if (!f)
+            fprintf(stderr, "[epoxy] NO ENTRY POINT for %s "
+                            "(eglGetProcAddress and dlsym both failed)\n", name);
+        return f;
+    }
+#else
     if (epoxy_current_context_is_glx()) {
         return epoxy_get_proc_address(name);
     } else {
         get_dlopen_handle(&api.gles1_handle, GLES1_LIB, true, true);
         return do_dlsym(&api.gles1_handle, name, true);
     }
+#endif
 }
 
