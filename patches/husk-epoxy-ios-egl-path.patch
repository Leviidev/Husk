+#if defined(__APPLE__) && TARGET_OS_IPHONE
+    /*
+     * Husk: WebKit builds ANGLE with its entry points renamed -- glDrawArrays
+     * is exported as GL_DrawArrays, eglChooseConfig as EGL_ChooseConfig --
+     * because WebCore reaches them through ANGLE's own loader rather than by
+     * linking them. The EGL half is aliased back at link time, but the same
+     * trick fails for GL: ld reports 828 duplicate symbols, because ANGLE
+     * already carries internal gl* symbols of its own that the aliases collide
+     * with. Translating the name here costs one failed dlsym and avoids
+     * fighting the linker over a thousand symbols.
+     */
+    if (!result && name[0] == 'g' && name[1] == 'l') {
+        char renamed[256];
+        snprintf(renamed, sizeof(renamed), "GL_%s", name + 2);
+        result = dlsym(*handle, renamed);
+    }
+    if (!result && strncmp(name, "egl", 3) == 0) {
+        char renamed[256];
+        snprintf(renamed, sizeof(renamed), "EGL_%s", name + 3);
+        result = dlsym(*handle, renamed);
+    }
+#endif
