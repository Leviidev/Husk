    },
    "Automatic": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动"
          }
        }
      }
    },
    "Automatic follows the system appearance — light, dark and tinted. The others pin one look. iOS shows its own confirmation after a change; that alert cannot be turned off.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「自动」跟随系统外观——浅色、深色和色调化。其余选项会固定一种外观。更改后 iOS 会显示自己的确认提示；该提示无法关闭。"
          }
        }
      }
    },
    "Automatic offers the controller for games that cannot be played without one (Unreal Engine games), when no real controller is connected. Always offers it for any game that understands one. A paired controller is always used.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「自动」会在没有连接实体控制器时，为必须用控制器的游戏（虚幻引擎游戏）提供屏幕控制器；对任何识别控制器的游戏则始终提供。已配对的控制器始终优先生效。"
          }
        }
      }
    },
    "Back to Husk": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "返回 Husk"
          }
        }
      }
    },
    "Boots the guest as soon as Husk opens, once JIT is available. Off means you start it yourself.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "JIT 可用时，Husk 一打开就启动客户机。关闭则需你手动启动。"
          }
        }
      }
    },
    "Boots the guest as soon as Husk opens, when JIT is available.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "JIT 可用时，Husk 一打开就启动客户机。"
          }
        }
      }
    },
    "Both sides must be between 240 and 2560.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两边都必须介于 240 和 2560 之间。"
