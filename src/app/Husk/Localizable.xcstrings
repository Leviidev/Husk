    "Runs Android games straight on your iPhone, without starting Android. Add an APK, or a bundle (.xapk, .apkm, .apks) — or pick a base APK and its split pieces together. Husk keeps its own copy, apart from Android's.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无需启动 Android，直接在 iPhone 上运行 Android 游戏。添加一个 APK，或一个捆绑包（.xapk、.apkm、.apks）——也可以一次选中基础 APK 及其分片。Husk 会保留自己的副本，与 Android 的分开。"
          }
        }
      }
    },
    "Save Android": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存 Android"
          }
        }
      }
    },
    "Save Android to keep it past this session.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存 Android，它才能留存到本次会话之后。"
          }
        }
      }
    },
    "Save automatically": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动保存"
          }
        }
      }
    },
    "Save now": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立即保存"
          }
        }
      }
    },
    "Saved machine": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存的机器"
          }
        }
      }
    },
    "Saves the machine once Android settles, so later launches restore in seconds instead of booting.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等 Android 稳定后保存机器，之后启动只需几秒恢复，而无需重新引导。"
          }
        }
      }
    },
    "Saves, settings and caches the game made here are deleted.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "游戏在此产生的存档、设置和缓存都会被删除。"
          }
        }
      }
    },
    "Saving Android — the screen will freeze briefly": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在保存 Android — 画面会短暂冻结"
          }
        }
      }
    },
    "Saving closes apps but leaves Android's framework running, so the network still works after a restore.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存会关闭应用，但让 Android 框架继续运行，因此恢复后网络仍然可用。"
          }
        }
      }
    },
    "Saving stops the framework too. Clears every GPU resource, which is steadier — but the network may not come back until a cold boot.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存时连框架也一并停止。这会清空所有 GPU 资源，因此更稳定——但网络可能要等到冷启动才会恢复。"
          }
        }
      }
    },
    "Saving…": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在保存…"
          }
        }
      }
    },
