        }
      }
    },
    "They go to %@. Unmodified APKs install from here too.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它们会放入 %@。未经修改的 APK 也可以从这里安装。"
          }
        }
      }
    },
    "This device closed the connection, which usually means it no longer accepts Husk's pairing. Pair again, and check that LocalDevVPN is connected.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台设备断开了连接，通常意味着它不再接受 Husk 的配对。请重新配对，并确认 LocalDevVPN 已连接。"
          }
        }
      }
    },
    "This device is jailbroken, so JIT comes from the jailbreak's Allow JIT in Apps setting.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台设备已越狱，因此 JIT 来自越狱设置中的「允许应用使用 JIT」。"
