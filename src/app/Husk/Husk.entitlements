<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Lets StikDebug attach to us as a debugger. Without this there is no JIT. -->
	<key>get-task-allow</key>
	<true/>
	<!-- Honoured on standard sideloaded apps for MAP_JIT. Note: this entitlement
	     is banned on TrollStore (see https://github.com/opa334/TrollStore#banned-entitlements)
	     under PPL/TXM because process launch validation will kill the app. It is
	     stripped when packaging for TrollStore (see /scripts/package_ipa.sh). -->
	<key>dynamic-codesigning</key>
	<true/>
	<!-- An Android guest needs real RAM on top of the host app's own footprint.
	     Proven to work on sideloaded builds in AetherPS4-iOS. -->
	<key>com.apple.developer.kernel.increased-memory-limit</key>
	<true/>
	<!-- Mappings past ~4 GB need this. The guest RAM block plus the JIT's dual
	     RW/RX mapping exceed that, and without it the large mapping is simply
	     refused. Husk does not depend on it being honoured: the address space is
	     probed at startup and the guest is sized to whatever actually maps. -->
	<key>com.apple.developer.kernel.extended-virtual-addressing</key>
	<true/>
</dict>
</plist>
